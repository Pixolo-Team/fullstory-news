---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { StaticPageData } from '@/content/static-pages';

interface Props {
  page: StaticPageData;
}

const { page } = Astro.props;
---

<BaseLayout description={page.intro} title={`${page.title} - Full Story`}>
  <div class="mx-auto max-w-[42rem] px-4 py-10 sm:px-5 md:py-14">
    <h1 class="text-title mb-7 mt-0">{page.title}</h1>

    <div class="remarque-prose">
      <p>{page.intro}</p>
      <Fragment set:html={page.contentHtml} />
    </div>
  </div>
</BaseLayout>
