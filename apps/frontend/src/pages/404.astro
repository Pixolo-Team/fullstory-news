---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout noindex title="Not found - Full Story">
  <div class="mx-auto max-w-[42rem] px-4 py-10 sm:px-5 md:py-14">
    <h1 class="text-title mb-5 mt-0">That page does not exist.</h1>
    <p
      class="text-body mb-6 mt-0 max-w-[34rem] text-pretty"
      style="color:var(--color-fg-muted)"
    >
      The Story may have been unpublished, or the address may be mistyped.
    </p>
    <a class="text-body link-accent" href="/">Back to Home</a>
  </div>
</BaseLayout>
