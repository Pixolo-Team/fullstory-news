---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoryCard from '@/components/StoryCard.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import { getArticleRequest } from '@/requests/get-article.request';
import { getSimilarArticlesRequest } from '@/requests/get-articles.request';
import { formatDateService } from '@/services/format-date.service';

const { slug, id } = Astro.params;

const article = await getArticleRequest(slug ?? '', id ?? '');

if (!article) {
  return Astro.redirect('/404', 404);
}

const similar = await getSimilarArticlesRequest(article.id, 3);
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
---

<BaseLayout
  description={article.subHeadline ?? article.headline}
  title={`${article.headline} — Full Story`}
>
  <div style="max-width:58rem;margin:0 auto;padding:var(--space-9) clamp(var(--space-4),4vw,var(--space-6)) var(--space-10)">
    <header class="remarque-post-header" style="max-width:46rem;margin-inline:auto">
      <p class="remarque-post-kicker">
        <a
          class="remarque-post-kicker-section"
          href={`/${article.category.slug}`}
          style="text-decoration:none;color:inherit">{article.category.name}</a
        >
      </p>

      <h1 class="text-title" style="margin:0">{article.headline}</h1>

      {
        article.subHeadline && (
          <p class="remarque-lead-lede" data-lede style="margin-top:var(--space-4)">
            {article.subHeadline}
          </p>
        )
      }

      <p class="remarque-post-kicker" style="margin-top:var(--space-5)">
        <span>By {article.author.name}</span>
        <span class="remarque-dot" aria-hidden="true">·</span>
        <span>{formatDateService(article.publishedAt)}</span>
      </p>

      <ShareButtons title={article.headline} url={shareUrl} />
    </header>

    {
      article.heroImageUrl && (
        <img
          alt=""
          src={article.heroImageUrl}
          style="width:100%;aspect-ratio:3 / 2;margin-top:var(--space-8);margin-bottom:var(--space-8);object-fit:cover;display:block;border:var(--border-width) solid var(--color-border);border-radius:var(--radius-sm)"
        />
      )
    }

    <div
      class="remarque-prose"
      style="max-width:46rem;margin-inline:auto"
      set:html={article.contentHtml}
    />

    {
      article.tags.length > 0 && (
        <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-3);margin-top:var(--space-7);max-width:46rem;margin-inline:auto">
          <span class="text-label">Tags</span>
          {article.tags.map((tag) => (
            <a
              href={`/search?q=${encodeURIComponent(tag)}`}
              class="link-accent" style="font-family:var(--font-mono);font-size:var(--text-meta)"
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    {
      article.instagramPosts.length > 0 && (
        <section style="margin-top:var(--space-9);padding-top:var(--space-6);border-top:var(--border-width) solid var(--color-border)">
          <p class="text-label" style="margin:0 0 var(--space-5)">
            Related Instagram posts
          </p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:var(--space-5)">
            {article.instagramPosts.map((post) => (
              <article style="display:flex;flex-direction:column;gap:var(--space-3)">
                <a
                  href={post.instagramUrl}
                  rel="noopener noreferrer"
                  class="link-accent" style="font-family:var(--font-mono);font-size:var(--text-meta)"
                  target="_blank"
                >
                  View on Instagram →
                </a>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      similar.length > 0 && (
        <section style="margin-top:var(--space-9);padding-top:var(--space-6);border-top:var(--border-width) solid var(--color-border)">
          <p class="text-label" style="margin:0 0 var(--space-5)">
            Similar stories
          </p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:var(--space-5)">
            {similar.map((item) => (
              <StoryCard article={item} showSection={false} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
