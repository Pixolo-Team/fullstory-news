---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoryCard from '@/components/StoryCard.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import { getArticleRequest } from '@/requests/get-article.request';
import { getSimilarArticlesRequest } from '@/requests/get-articles.request';
import { formatDateService } from '@/services/format-date.service';

const { slug } = Astro.params;

const article = await getArticleRequest(slug ?? '');

if (!article) {
  return Astro.redirect('/404', 404);
}

const similar = await getSimilarArticlesRequest(article.id, 3);

// Astro.url.origin reflects the request that actually reached this page, so
// it is right in every environment without depending on PUBLIC_SITE_URL
// being set. Using Astro.site here previously sent readers a share link
// pointing at localhost whenever that env var was missing on the host.
const shareUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
---

<BaseLayout
  article={{
    publishedTime: article.publishedAt ?? article.updatedAt,
    modifiedTime: article.updatedAt,
    author: article.author.name,
    section: article.category.name,
    tags: article.tags,
  }}
  description={article.subHeadline ?? article.headline}
  image={article.heroImageUrl ?? undefined}
  title={`${article.headline} - Full Story`}
>
  <div class="mx-auto max-w-[58rem] px-4 py-10 sm:px-6 md:py-14">
    <style>
      .story-tag {
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        padding: 0 0.6rem;
        border: var(--border-width) solid var(--color-border-bold);
        border-radius: var(--radius-sm);
        color: var(--color-accent);
        text-decoration: none;
        transition:
          color var(--motion-fast) var(--motion-easing),
          border-color var(--motion-fast) var(--motion-easing),
          background-color var(--motion-fast) var(--motion-easing);
      }

      .story-tag:hover {
        color: var(--color-accent-hover);
        border-color: var(--color-accent-hover);
        background-color: var(--color-accent-subtle);
      }

      /* The design system's lede style includes a large drop-cap first
         letter, meant for a lead paragraph opening a piece. Applied to a
         subheadline it reads as a typo, not a design choice - reset it back
         to a plain first character. The rest of the lede's italic, muted
         styling stays; only the first-letter treatment is undone. */
      .remarque-post-header .remarque-lead-lede::first-letter {
        all: unset;
        font: inherit;
        color: inherit;
      }
    </style>

    <header class="remarque-post-header mx-auto max-w-[46rem]">
      <p class="remarque-post-kicker">
        <a
          class="remarque-post-kicker-section"
          href={`/${article.category.slug}`}
        >{article.category.name}</a
        >
      </p>

      <h1 class="text-title m-0">{article.headline}</h1>

      {
        article.subHeadline && (
          <p class="remarque-lead-lede mt-4" data-lede>
            {article.subHeadline}
          </p>
        )
      }

      <p class="remarque-post-kicker mt-5">
        <span>By {article.author.name}</span>
        <span class="remarque-dot" aria-hidden="true">&middot;</span>
        <span>{formatDateService(article.publishedAt)}</span>
      </p>

      <ShareButtons title={article.headline} url={shareUrl} />
    </header>

    {
      article.heroImageUrl && (
        <img
          alt=""
          class="my-8 block aspect-[3/2] w-full rounded-sm border object-cover"
          src={article.heroImageUrl}
          style="border-width:var(--border-width);border-color:var(--color-border)"
        />
      )
    }

    {
      /* remarque-prose--dropcap gives the article's opening paragraph a large
         first letter - the one place on this page that treatment belongs. */
    }
    <div
      class="remarque-prose remarque-prose--dropcap mx-auto max-w-[46rem]"
      set:html={article.contentHtml}
    />

    {
      article.tags.length > 0 && (
        <div class="mx-auto mt-7 flex max-w-[46rem] flex-wrap items-baseline gap-3">
          <span class="text-label">Tags</span>
          {article.tags.map((tag) => (
            <a
              href={`/search?q=${encodeURIComponent(tag)}`}
              class="story-tag"
              style="font-family:var(--font-mono);font-size:var(--text-meta)"
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    {
      article.instagramPosts.length > 0 && (
        <section class="mt-9 border-t pt-6" style="border-top-width:var(--border-width);border-color:var(--color-border)">
          <p class="text-label mb-5 mt-0">
            Related Videos
          </p>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
            {/* Never more than 3: a wall of reels overwhelms the Story it sits under. */}
            {article.instagramPosts.slice(0, 3).map((post) => (
              <a
                class="group relative block aspect-[9/16] overflow-hidden rounded-md border"
                href={post.instagramUrl}
                rel="noopener noreferrer"
                style="border-width:var(--border-width);border-color:var(--color-border)"
                target="_blank"
              >
                <img
                  alt=""
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                  src={`https://picsum.photos/seed/ig-${post.id}/480/854`}
                />

                {/* Reel affordance: a centered play glyph, so the tile reads as video
                    even though it is a thumbnail rather than a live embed. */}
                <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/10 transition-colors group-hover:bg-black/25">
                  <svg fill="none" height="40" viewBox="0 0 24 24" width="40">
                    <circle cx="12" cy="12" fill="rgba(0,0,0,0.35)" r="11" />
                    <path d="M9.5 7.5L17 12L9.5 16.5V7.5Z" fill="white" />
                  </svg>
                </span>

                <span class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center gap-1.5 bg-gradient-to-t from-black/80 to-transparent px-2.5 pb-2.5 pt-6 text-white">
                  <svg fill="none" height="14" viewBox="0 0 24 24" width="14">
                    <rect height="20" rx="5" stroke="white" stroke-width="1.8" width="20" x="2" y="2" />
                    <circle cx="12" cy="12" r="4.2" stroke="white" stroke-width="1.8" />
                    <circle cx="17.2" cy="6.8" fill="white" r="1.1" />
                  </svg>
                  <span class="font-mono text-[11px] tracking-wide">View reel</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      similar.length > 0 && (
        <section class="mt-9 border-t pt-6" style="border-top-width:var(--border-width);border-color:var(--color-border)">
          <p class="text-label mb-5 mt-0">
            Similar stories
          </p>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {similar.map((item) => (
              <StoryCard article={item} showSection={false} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
