---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StoryCard from '@/components/StoryCard.astro';
import StoryRow from '@/components/StoryRow.astro';
import { buildStoryPathService } from '@/services/build-story-path.service';
import { formatDateService } from '@/services/format-date.service';
import {
  getArticlesByCategoryRequest,
  getLatestArticlesRequest,
  getTrendingArticlesRequest,
} from '@/requests/get-articles.request';

/** Story cards shown per Category block on the home page. */
const CATEGORY_BLOCK_SIZE = 3;


const [trending, latest, categoryGroups] = await Promise.all([
  getTrendingArticlesRequest(3),
  getLatestArticlesRequest(8),
  getArticlesByCategoryRequest(CATEGORY_BLOCK_SIZE + 1),
]);

const hasAnything = trending.length > 0 || latest.length > 0 || categoryGroups.length > 0;
const trendingLead = trending[0];
const trendingSecondary = trending.slice(1, 3);
---

<BaseLayout
  description="Simple journalism, reported daily and readable without an account."
  title="Full Story"
>
  <div class="container mx-auto px-4 py-10 sm:px-5 md:py-14">
    {
      !hasAnything && (
        <p class="text-body m-0" style="color:var(--color-muted)">
          No Stories have been published yet.
        </p>
      )
    }

    {
      trending.length > 0 && (
        <section>
          <SectionHeading label="Trending stories" />
          <div
            class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1.8fr)_minmax(18rem,0.95fr)] lg:items-start"
            data-grid="trending"
          >
            {trendingLead && (
              <div class="min-w-0">
                <StoryCard article={trendingLead} size="large" />
              </div>
            )}
            <div class="grid gap-5 lg:grid-rows-2">
              {trendingSecondary.map((article) => (
                <StoryCard article={article} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      latest.length > 0 && (
        <section class="mt-9">
          <SectionHeading label="Latest stories" />
          <div class="mt-5">
            {latest.map((article, index) => (
              <article
                class:list={[
                  'grid items-start gap-x-6 gap-y-3 py-5 md:grid-cols-[7.5rem_minmax(0,1fr)_11rem]',
                  index < latest.length - 1 && 'border-b',
                ]}
                style="border-bottom-width:var(--border-width);border-color:var(--color-border)"
              >
                <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 md:block">
                  <p class="remarque-entry-kicker m-0">
                    <span class="remarque-entry-section">{article.category.name}</span>
                  </p>
                  <p
                    class="m-0"
                    style="font-family:var(--font-mono);font-size:var(--text-meta);letter-spacing:var(--tracking-meta);color:var(--color-fg-muted)"
                  >
                    {formatDateService(article.publishedAt)}
                  </p>
                </div>

                <div class="flex min-w-0 flex-col gap-2">
                  <h3
                    class="m-0 text-balance text-[1.55rem] font-medium leading-[1.18]"
                    style="font-family:var(--font-display);letter-spacing:var(--tracking-title)"
                  >
                    <a class="story-link" href={buildStoryPathService(article)}>
                      {article.headline}
                    </a>
                  </h3>

                  {
                    article.subHeadline && (
                      <p
                        class="m-0 max-w-[68ch] text-pretty"
                        style="font-family:var(--font-body);font-size:var(--text-body);line-height:var(--leading-body);color:var(--color-fg-muted)"
                      >
                        {article.subHeadline}
                      </p>
                    )
                  }
                </div>

                {
                  article.heroImageUrl && (
                    <a class="block no-underline md:justify-self-end" data-thumb href={buildStoryPathService(article)}>
                      <img
                        alt=""
                        class="block aspect-[4/3] w-full max-w-[11rem] rounded-sm border object-cover"
                        loading="lazy"
                        src={article.heroImageUrl}
                        style="border-width:var(--border-width);border-color:var(--color-border)"
                      />
                    </a>
                  )
                }
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      categoryGroups.map((group) => {
        // One extra Story was requested purely to answer "is there more?".
        // Showing it would break the three-card row, so it is dropped here.
        const hasMore = group.items.length > CATEGORY_BLOCK_SIZE;
        const shown = group.items.slice(0, CATEGORY_BLOCK_SIZE);

        return (
          <section class="mt-9">
            <SectionHeading
              href={hasMore ? `/${group.category.slug}` : undefined}
              label={group.category.name}
            />
            <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-grid="category">
              {shown.map((article) => (
                <StoryCard article={article} showSection={false} />
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>
