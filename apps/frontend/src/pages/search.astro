---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Pagination from '@/components/Pagination.astro';
import { buildStoryPathService } from '@/services/build-story-path.service';
import { formatDateService } from '@/services/format-date.service';
import { searchArticlesRequest } from '@/requests/search-articles.request';
import { getLatestArticlesRequest } from '@/requests/get-articles.request';

const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const page = Number(Astro.url.searchParams.get('page') ?? '1');

// With no query the page still has something to offer: the most recent
// Stories, newest first. Searching replaces them with matches.
const results = query ? await searchArticlesRequest(query, page) : null;
const recent = query ? [] : await getLatestArticlesRequest(10);

const resultLine = results
  ? `${results.total} ${results.total === 1 ? 'result' : 'results'} for "${query}"`
  : '';
---

<BaseLayout description="Search Full Story" noindex title="Search - Full Story">
  <div class="container mx-auto px-4 py-10 sm:px-5 md:py-14">
    <style>
      .search-page-input:focus-visible {
        outline: none;
        border-color: var(--color-fg);
      }
    </style>

    <h1 class="text-title mb-6 mt-0">Search</h1>

    <form action="/search" class="flex flex-wrap items-center gap-3" method="get" role="search">
      <input
        aria-label="Search Stories"
        class="remarque-input search-page-input"
        name="q"
        placeholder="Search Stories"
        style="flex:1 1 18rem;min-width:0"
        type="search"
        value={query}
      />
      <button class="remarque-button remarque-button--primary h-11" type="submit">Search</button>
    </form>

    {
      !query && recent.length > 0 && (
        <>
          <p class="text-label mb-1 mt-7">Recent stories</p>

          <div class="border-t" style="border-top-width:var(--border-width);border-color:var(--color-border-bold)">
            {recent.map((article) => (
              <article class="flex flex-col gap-2 border-b py-5" style="border-bottom-width:var(--border-width);border-color:var(--color-border)">
                <h3
                  class="m-0 text-balance text-[1.3125rem] font-medium leading-[1.25]"
                  data-story-title
                  style="font-family:var(--font-display);letter-spacing:var(--tracking-title)"
                >
                  <a class="story-link" href={buildStoryPathService(article)}>
                    {article.headline}
                  </a>
                </h3>

                {article.subHeadline && (
                  <p class="m-0 text-pretty" style="font-family:var(--font-body);font-size:var(--text-body);line-height:var(--leading-body);color:var(--color-fg-muted)">
                    {article.subHeadline}
                  </p>
                )}

                <p class="remarque-entry-kicker m-0">
                  <span class="remarque-entry-section">{article.category.name}</span>
                  <span class="remarque-dot" aria-hidden="true">&middot;</span>
                  <span>{formatDateService(article.publishedAt)}</span>
                </p>
              </article>
            ))}
          </div>
        </>
      )
    }

    {
      !query && recent.length === 0 && (
        <p class="text-body mt-7" style="color:var(--color-muted)">
          No Stories have been published yet.
        </p>
      )
    }

    {
      results && results.items.length === 0 && (
        <p class="text-body mt-7" style="color:var(--color-muted)">
          No Stories found for that search.
        </p>
      )
    }

    {
      results && results.items.length > 0 && (
        <>
          <p class="text-meta mb-1 mt-7">{resultLine}</p>

          <div class="border-t" style="border-top-width:var(--border-width);border-color:var(--color-border-bold)">
            {results.items.map((article) => (
              <article class="flex flex-col gap-2 border-b py-5" style="border-bottom-width:var(--border-width);border-color:var(--color-border)">
                <h3
                  class="m-0 text-balance text-[1.3125rem] font-medium leading-[1.25]"
                  data-story-title
                  style="font-family:var(--font-display);letter-spacing:var(--tracking-title)"
                >
                  <a class="story-link" href={buildStoryPathService(article)}>
                    {article.headline}
                  </a>
                </h3>

                {article.subHeadline && (
                  <p class="m-0 text-pretty" style="font-family:var(--font-body);font-size:var(--text-body);line-height:var(--leading-body);color:var(--color-fg-muted)">
                    {article.subHeadline}
                  </p>
                )}

                <p class="remarque-entry-kicker m-0">
                  <span class="remarque-entry-section">{article.category.name}</span>
                  <span class="remarque-dot" aria-hidden="true">&middot;</span>
                  <span>{formatDateService(article.publishedAt)}</span>
                </p>
              </article>
            ))}
          </div>

          <Pagination
            basePath="/search"
            page={results.page}
            query={query}
            totalPages={results.totalPages}
          />
        </>
      )
    }
  </div>
</BaseLayout>
