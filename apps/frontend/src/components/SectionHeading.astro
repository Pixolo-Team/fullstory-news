---
interface Props {
  label: string;
  href?: string;
  linkLabel?: string;
}

const { label, href, linkLabel = 'View all ->' } = Astro.props;
---

{
  href ? (
    <div
      class="flex items-baseline justify-between gap-4 border-b pb-3"
      style="border-bottom-width:var(--border-width);border-color:var(--color-border-bold)"
    >
      <p class="text-label m-0">
        {label}
      </p>
      <a
        href={href}
        class="link-accent whitespace-nowrap"
        style="font-family:var(--font-mono);font-size:var(--text-meta);text-decoration:none;border-bottom:var(--border-width) solid currentColor;padding-bottom:0.1rem"
      >
        {linkLabel}
      </a>
    </div>
  ) : (
    <p
      class="text-label mb-1 mt-0 border-b pb-3"
      style="border-bottom-width:var(--border-width);border-color:var(--color-border-bold)"
    >
      {label}
    </p>
  )
}
