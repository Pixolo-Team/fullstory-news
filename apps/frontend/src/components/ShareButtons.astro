---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class="mt-5 flex flex-wrap gap-2" data-share data-title={title} data-url={url}>
  <a
    class="remarque-button whitespace-nowrap no-underline"
    href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`}
    rel="noopener noreferrer"
    target="_blank">WhatsApp</a
  >
  <a
    class="remarque-button whitespace-nowrap no-underline"
    href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
    rel="noopener noreferrer"
    target="_blank">X</a
  >
  <a
    class="remarque-button whitespace-nowrap no-underline"
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    rel="noopener noreferrer"
    target="_blank">Facebook</a
  >
  <button class="remarque-button whitespace-nowrap" data-copy type="button">Copy link</button>
  <button class="remarque-button whitespace-nowrap" data-native hidden type="button">Share</button>
</div>

<script>
  const container = document.querySelector<HTMLElement>('[data-share]');

  if (container) {
    const url = container.dataset.url ?? window.location.href;
    const title = container.dataset.title ?? document.title;

    const copyButton = container.querySelector<HTMLButtonElement>('[data-copy]');
    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copyButton.textContent = 'Copied';
        setTimeout(() => (copyButton.textContent = 'Copy link'), 2000);
      } catch {
        copyButton.textContent = 'Press Ctrl+C';
      }
    });

    // The native sheet is the better option on mobile, so it replaces the
    // explicit buttons only where the browser actually supports it.
    const nativeButton = container.querySelector<HTMLButtonElement>('[data-native]');
    if (nativeButton && typeof navigator.share === 'function') {
      nativeButton.hidden = false;
      nativeButton.addEventListener('click', () => {
        void navigator.share({ title, url }).catch(() => {
          // The reader dismissed the sheet.
        });
      });
    }
  }
</script>
