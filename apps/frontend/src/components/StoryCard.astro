---
import type { ArticleData } from '@/types/api.types';
import { buildStoryPathService } from '@/services/build-story-path.service';
import { formatDateService } from '@/services/format-date.service';

interface Props {
  article: ArticleData;
  size?: 'large' | 'small';
  showSection?: boolean;
  imageClassName?: string;
  wrapperClassName?: string;
}

const {
  article,
  size = 'small',
  showSection = true,
  imageClassName,
  wrapperClassName,
} = Astro.props;

const href = buildStoryPathService(article);
const imageSizeClassName =
  imageClassName ?? (size === 'large' ? 'aspect-[16/9] xl:aspect-[16/7]' : 'aspect-[3/2]');
---

<article class:list={['flex flex-col gap-3', wrapperClassName]} data-story-card>
  {
    article.heroImageUrl && (
      <a class="block no-underline" data-thumb href={href} name={article.headline}>
        <img
          alt={article.headline}
          class:list={[
            'block w-full rounded-sm border object-cover',
            imageSizeClassName,
          ]}
          decoding="async"
          loading="lazy"
          src={article.heroImageUrl}
          style="border-width:var(--border-width);border-color:var(--color-border)"
        />
      </a>
    )
  }

  <h3
    class:list={[
      'm-0 text-balance font-medium leading-tight',
      size === 'large' ? 'text-[clamp(1.3125rem,4.5vw,1.5rem)]' : 'text-[1.1875rem]',
    ]}
    style="font-family:var(--font-display);letter-spacing:var(--tracking-title)"
  >
    <a class="story-link" href={href} name={article.headline}>{article.headline}</a>
  </h3>

  {
    size === 'large' && article.subHeadline && (
      <p
        class="m-0 max-w-[58ch] text-pretty"
        data-story-subheadline
        style="font-family:var(--font-body);font-size:var(--text-body);line-height:var(--leading-body);color:var(--color-fg-muted)"
      >
        {article.subHeadline}
      </p>
    )
  }

  <style>
    /* Phones stack title, subtitle and kicker with breathing room to spare,
       so the card gap steps down from 12px to 10px and the subtitle sets
       tighter. `!important` beats the Tailwind gap class and the inline
       line-height, the same pattern BaseLayout uses for mobile overrides. */
    @media (max-width: 640px) {
      [data-story-card] {
        gap: 0.625rem !important;
      }

      [data-story-card] [data-story-subheadline] {
        line-height: var(--leading-meta) !important;
      }
    }
  </style>

  <p class="remarque-entry-kicker m-0">
    {showSection && <span class="remarque-entry-section">{article.category.name}</span>}
    {showSection && <span class="remarque-dot" aria-hidden="true">&middot;</span>}
    <span>{formatDateService(article.publishedAt)}</span>
  </p>
</article>
