---
import type { CategoryData } from '@/types/api.types';
import { getWeatherRequest } from '@/requests/get-weather.request';

interface Props {
  categories: CategoryData[];
}

const { categories } = Astro.props;

const weather = await getWeatherRequest();
---

<header class="w-full border-b" style="border-color:var(--color-border);border-bottom-width:var(--border-width)">
  <div class="container mx-auto w-full px-4 sm:px-6">
    <div class="flex w-full flex-col gap-4 py-5 pb-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-6">
      <a
        href="/"
        style="font-family:var(--font-display);font-size:1.875rem;line-height:1.1;letter-spacing:var(--tracking-title);color:var(--color-fg);text-decoration:none;font-variant-caps:all-small-caps"
        >Full Story</a
      >

      <div class="flex w-full items-start justify-between gap-3 sm:w-auto sm:items-center sm:gap-4">
        <p class="remarque-masthead-dateline" style="margin:0;justify-content:flex-end">
          <span id="dateline-day"></span>
          <span class="remarque-dot" aria-hidden="true">&middot;</span>
          <span id="dateline-time"></span>
          {
            weather && (
              <>
                <span class="remarque-dot" aria-hidden="true">&middot;</span>
                <span id="dateline-city">{weather.city}</span>
                <span class="remarque-dot" aria-hidden="true">&middot;</span>
                <span id="dateline-temp">{weather.temperatureC}&deg;C</span>
              </>
            )
          }
        </p>

        <button
          aria-label="Switch theme"
          aria-pressed="false"
          class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-sm border p-0 leading-none"
          id="theme-toggle"
          style="border-color:var(--color-border-bold);color:var(--color-fg);background:transparent"
          title="Switch theme"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="block h-4 w-4 shrink-0"
            data-icon="sun"
            fill="none"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="1.8"
            viewBox="0 0 24 24"
            width="16"
          >
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6"></path>
          </svg>
          <svg
            aria-hidden="true"
            class="block h-4 w-4 shrink-0"
            data-icon="moon"
            fill="none"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="display:none"
            stroke-width="1.8"
            viewBox="0 0 24 24"
            width="16"
          >
            <path d="M20.5 14.6A8.6 8.6 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="w-full border-t" style="border-color:var(--color-border);border-top-width:var(--border-width)">
    <div
      class="container mx-auto flex flex-wrap items-center justify-between gap-4 px-4 pb-1 sm:px-6"
      data-nav-row
    >
      <button
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label="Open menu"
        class="remarque-button"
        data-nav-toggle
        id="nav-toggle"
        type="button"
      >
        <svg
          aria-hidden="true"
          data-icon="open"
          fill="none"
          height="18"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="1.8"
          viewBox="0 0 24 24"
          width="18"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          aria-hidden="true"
          data-icon="close"
          fill="none"
          height="18"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="1.8"
          style="display:none"
          viewBox="0 0 24 24"
          width="18"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>

      <nav class="flex min-w-0 gap-2 overflow-x-auto" data-primary-nav id="primary-nav">
        <a
          class="nav-link"
          href="/"
          style="white-space:nowrap;font-variant-caps:all-small-caps;letter-spacing:var(--tracking-caps);font-size:var(--text-body)"
          >Home</a
        >
        {
          categories.map((category) => (
            <a
              class="nav-link"
              href={`/${category.slug}`}
              style="white-space:nowrap;font-variant-caps:all-small-caps;letter-spacing:var(--tracking-caps);font-size:var(--text-body)"
            >
              {category.name}
            </a>
          ))
        }
      </nav>

      <a
        class="nav-link inline-flex items-center gap-2 whitespace-nowrap"
        href="/search"
        style="font-family:var(--font-mono);font-size:var(--text-meta)"
      >
        <svg
          aria-hidden="true"
          fill="none"
          height="15"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="2"
          style="display:block"
          viewBox="0 0 24 24"
          width="15"
        >
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="M15.5 15.5 21 21"></path>
        </svg>
        <span>Search</span>
      </a>
    </div>
  </div>
</header>

<script>
  // The dateline must show the reader's own day and time, so it is rendered in
  // the browser rather than baked in at build time.
  function renderDateline(): void {
    const now = new Date();

    const day = document.getElementById('dateline-day');
    const time = document.getElementById('dateline-time');

    if (day) {
      day.textContent = new Intl.DateTimeFormat(undefined, {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
      }).format(now);
    }

    if (time) {
      time.textContent = new Intl.DateTimeFormat(undefined, {
        hour: '2-digit',
        minute: '2-digit',
      }).format(now);
    }
  }

  renderDateline();
  setInterval(renderDateline, 30_000);

  // Mobile menu. The nav stays in the DOM at every width; only its display
  // changes, so there is one set of links and one source of truth.
  const navToggle = document.getElementById('nav-toggle');
  const primaryNav = document.getElementById('primary-nav');

  navToggle?.addEventListener('click', () => {
    const isOpen = primaryNav?.getAttribute('data-open') === 'true';
    const nextOpen = !isOpen;

    primaryNav?.setAttribute('data-open', String(nextOpen));
    navToggle.setAttribute('aria-expanded', String(nextOpen));
    navToggle.setAttribute('aria-label', nextOpen ? 'Close menu' : 'Open menu');

    const open = navToggle.querySelector<SVGElement>('[data-icon="open"]');
    const close = navToggle.querySelector<SVGElement>('[data-icon="close"]');
    if (open) open.style.display = nextOpen ? 'none' : '';
    if (close) close.style.display = nextOpen ? '' : 'none';
  });

  // Following a link should close the menu behind you.
  primaryNav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      primaryNav.setAttribute('data-open', 'false');
      navToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // The server renders the newsroom's weather so the masthead is never empty.
  // The browser then replaces it with the reader's own city.
  //
  // Location comes from an IP lookup, not the timezone: India is a single
  // timezone, so Asia/Kolkata would show "Kolkata" to a reader in Mumbai.
  // It is also not the Geolocation API - that prompts for permission before
  // the reader has read anything, for a temperature.
  async function renderLocalWeather(): Promise<void> {
    const cityEl = document.getElementById('dateline-city');
    const tempEl = document.getElementById('dateline-temp');
    if (!cityEl || !tempEl) return;

    try {
      const locationResponse = await fetch('https://ipwho.is/?fields=city,latitude,longitude,success');
      const place = await locationResponse.json();

      if (!place?.success || typeof place.latitude !== 'number') return;

      const weatherResponse = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${place.latitude}&longitude=${place.longitude}&current=temperature_2m`,
      );
      const weather = await weatherResponse.json();
      const temperature = weather?.current?.temperature_2m;

      if (typeof temperature !== 'number') return;

      if (place.city) cityEl.textContent = place.city;
      tempEl.textContent = `${Math.round(temperature)}\u00B0C`;
    } catch {
      // Offline, blocked or rate limited - the newsroom reading stands.
    }
  }

  void renderLocalWeather();
</script>
