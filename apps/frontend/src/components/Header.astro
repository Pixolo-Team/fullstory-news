---
import { Image } from 'astro:assets';
import type { CategoryData } from '@/types/api.types';
import { getWeatherRequest } from '@/requests/get-weather.request';

interface Props {
  categories: CategoryData[];
}

const { categories } = Astro.props;
const weather = await getWeatherRequest();
const pathname = Astro.url.pathname;
---

<style>
  /* The wordmark art is navy on transparent, so dark mode swaps in the
     off-white variant rendered from the same source file. Dark mode is either
     an explicit data-theme or the OS preference when no theme was chosen yet,
     matching how palette.css resolves light-dark(). */
  .brand-logo[data-variant='dark'] {
    display: none;
  }
  :global([data-theme='dark']) .brand-logo[data-variant='light'] {
    display: none;
  }
  :global([data-theme='dark']) .brand-logo[data-variant='dark'] {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brand-logo[data-variant='light'] {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .brand-logo[data-variant='dark'] {
      display: block;
    }
  }

  .brand-mark {
    width: min(100%, 12.5rem);
  }

  .search-shell {
    display: none;
    width: 100%;
    padding: 0 1rem 1rem;
  }

  .search-shell[data-open='true'] {
    display: block;
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    margin: 0 auto;
    padding-top: 0.75rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .search-input {
    flex: 1 1 16rem;
    min-width: 0;
  }

  .search-input:focus-visible {
    outline: none;
    border-color: var(--color-fg);
  }

  .nav-link.is-active {
    color: var(--color-accent);
  }

  .nav-link.is-active::after {
    content: '';
    display: block;
    width: 100%;
    border-bottom: var(--border-width) solid var(--color-accent);
    transform: translateY(0.25rem);
  }

  @media (max-width: 640px) {
    .masthead-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .brand-mark {
      width: min(100%, 7.5rem);
      flex: 0 0 auto;
    }

    .brand-logo {
      height: auto !important;
      width: 100% !important;
      max-width: 100%;
    }

    .masthead-meta {
      width: auto;
      flex: 1 1 auto;
      align-items: center;
      justify-content: flex-end;
      gap: 0.625rem;
    }

    .search-shell {
      padding-inline: 1rem;
      padding-bottom: 0.75rem;
    }

    .search-form {
      gap: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  @media (max-width: 420px) {
    .brand-mark {
      width: min(100%, 7.5rem);
    }
  }
</style>

<header class="w-full border-b" style="border-color:var(--color-border);border-bottom-width:var(--border-width)">
  <div class="container mx-auto w-full px-4 sm:px-6">
    <div class="masthead-row flex w-full flex-col gap-4 py-5 pb-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-6">
      <a
        href="/"
        class="brand-mark"
        aria-label="Full Story - home"
        style="display:inline-flex;align-items:center;text-decoration:none"
      >
        <Image
          class="brand-logo"
          data-variant="light"
          src="/images/full-story-logo.png"
          alt="Full Story"
          width={1280}
          height={456}
          style="height:auto;width:100%;max-width:100%"
        />
        <Image
          class="brand-logo"
          data-variant="dark"
          src="/images/full-story-logo-light.png"
          alt=""
          width={1280}
          height={456}
          style="height:auto;width:100%;max-width:100%"
        />
      </a>

      <div class="masthead-meta flex w-full items-start justify-between gap-3 sm:w-auto sm:items-center sm:gap-4">
        <p class="remarque-masthead-dateline" style="margin:0;justify-content:flex-end">
          <span id="dateline-day"></span>
          <span class="remarque-dot" aria-hidden="true">&middot;</span>
          <span id="dateline-time"></span>
          {
            weather && (
              <>
                <span class="remarque-dot" aria-hidden="true">&middot;</span>
                <span id="dateline-city">{weather.city}</span>
                <span class="remarque-dot" aria-hidden="true">&middot;</span>
                <span id="dateline-temp">{weather.temperatureC}&deg;C</span>
              </>
            )
          }
        </p>

        <button
          aria-label="Switch theme"
          aria-pressed="false"
          class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-sm border p-0 leading-none"
          id="theme-toggle"
          style="border-color:var(--color-border-bold);color:var(--color-fg);background:transparent"
          title="Switch theme"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="block h-4 w-4 shrink-0"
            data-icon="sun"
            fill="none"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="1.8"
            viewBox="0 0 24 24"
            width="16"
          >
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6"></path>
          </svg>
          <svg
            aria-hidden="true"
            class="block h-4 w-4 shrink-0"
            data-icon="moon"
            fill="none"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="display:none"
            stroke-width="1.8"
            viewBox="0 0 24 24"
            width="16"
          >
            <path d="M20.5 14.6A8.6 8.6 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="w-full border-t" style="border-color:var(--color-border);border-top-width:var(--border-width)">
    <div
      class="container mx-auto flex flex-wrap items-center justify-between gap-3 px-4 pb-1 sm:gap-4 sm:px-6"
      data-nav-row
    >
      <button
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label="Open menu"
        class="remarque-button"
        data-nav-toggle
        id="nav-toggle"
        type="button"
      >
        <svg
          aria-hidden="true"
          data-icon="open"
          fill="none"
          height="18"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="1.8"
          viewBox="0 0 24 24"
          width="18"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          aria-hidden="true"
          data-icon="close"
          fill="none"
          height="18"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="1.8"
          style="display:none"
          viewBox="0 0 24 24"
          width="18"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>

      <nav class="flex min-w-0 flex-1 gap-2 overflow-x-auto" data-primary-nav id="primary-nav">
        <a
          class:list={['nav-link', pathname === '/' && 'is-active']}
          href="/"
          style="white-space:nowrap;font-variant-caps:all-small-caps;letter-spacing:var(--tracking-caps);font-size:var(--text-body)"
          >Home</a
        >
        {
          categories.map((category) => (
            <a
              class:list={['nav-link', pathname === `/${category.slug}` && 'is-active']}
              href={`/${category.slug}`}
              style="white-space:nowrap;font-variant-caps:all-small-caps;letter-spacing:var(--tracking-caps);font-size:var(--text-body)"
            >
              {category.name}
            </a>
          ))
        }
      </nav>

      <button
        aria-controls="header-search"
        aria-expanded="false"
        aria-label="Open search"
        class="nav-link inline-flex shrink-0 items-center gap-2 whitespace-nowrap"
        data-search-toggle
        style="font-family:var(--font-mono);font-size:var(--text-meta)"
        type="button"
      >
        <svg
          aria-hidden="true"
          fill="none"
          height="15"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="2"
          style="display:block"
          viewBox="0 0 24 24"
          width="15"
        >
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="M15.5 15.5 21 21"></path>
        </svg>
        <span>Search</span>
      </button>
    </div>
    <div class="container mx-auto search-shell px-4 sm:px-6" data-search-shell data-open="false">
      <form action="/search" class="search-form" data-search-form id="header-search" method="get">
        <input
          aria-label="Search Stories"
          class="remarque-input search-input"
          data-search-input
          name="q"
          placeholder="Search Stories"
          type="search"
        />
      </form>
    </div>
  </div>
</header>

<script>
  // The dateline must show the reader's own day and time, so it is rendered in
  // the browser rather than baked in at build time.
  function renderDateline(): void {
    const now = new Date();

    const day = document.getElementById('dateline-day');
    const time = document.getElementById('dateline-time');

    if (day) {
      day.textContent = new Intl.DateTimeFormat(undefined, {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
      }).format(now);
    }

    if (time) {
      time.textContent = new Intl.DateTimeFormat(undefined, {
        hour: '2-digit',
        minute: '2-digit',
      }).format(now);
    }
  }

  renderDateline();
  setInterval(renderDateline, 30_000);

  // Mobile menu. The nav stays in the DOM at every width; only its display
  // changes, so there is one set of links and one source of truth.
  const navToggle = document.getElementById('nav-toggle');
  const primaryNav = document.getElementById('primary-nav');
  const searchToggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]');
  const searchShell = document.querySelector<HTMLElement>('[data-search-shell]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const searchForm = document.querySelector<HTMLFormElement>('[data-search-form]');

  navToggle?.addEventListener('click', () => {
    const isOpen = primaryNav?.getAttribute('data-open') === 'true';
    const nextOpen = !isOpen;

    primaryNav?.setAttribute('data-open', String(nextOpen));
    navToggle.setAttribute('aria-expanded', String(nextOpen));
    navToggle.setAttribute('aria-label', nextOpen ? 'Close menu' : 'Open menu');

    const open = navToggle.querySelector<SVGElement>('[data-icon="open"]');
    const close = navToggle.querySelector<SVGElement>('[data-icon="close"]');
    if (open) open.style.display = nextOpen ? 'none' : '';
    if (close) close.style.display = nextOpen ? '' : 'none';
  });

  // Following a link should close the menu behind you.
  primaryNav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      primaryNav.setAttribute('data-open', 'false');
      navToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  searchToggle?.addEventListener('click', () => {
    const isOpen = searchShell?.getAttribute('data-open') === 'true';
    const nextOpen = !isOpen;

    searchShell?.setAttribute('data-open', String(nextOpen));
    searchToggle.setAttribute('aria-expanded', String(nextOpen));
    searchToggle.setAttribute('aria-label', nextOpen ? 'Close search' : 'Open search');

    if (nextOpen) {
      searchInput?.focus();
    } else {
      searchInput?.blur();
    }
  });

  searchForm?.addEventListener('submit', (event) => {
    if (!searchInput?.value.trim()) {
      event.preventDefault();
      searchInput?.focus();
    }
  });

  // The server renders the newsroom's weather so the masthead is never empty.
  // The browser then replaces it with the reader's own city.
  //
  // Location comes from an IP lookup, not the timezone: India is a single
  // timezone, so Asia/Kolkata would show "Kolkata" to a reader in Mumbai.
  // It is also not the Geolocation API - that prompts for permission before
  // the reader has read anything, for a temperature.
  async function renderLocalWeather(): Promise<void> {
    const cityEl = document.getElementById('dateline-city');
    const tempEl = document.getElementById('dateline-temp');
    if (!cityEl || !tempEl) return;

    try {
      const locationResponse = await fetch('https://ipwho.is/?fields=city,latitude,longitude,success');
      const place = await locationResponse.json();

      if (!place?.success || typeof place.latitude !== 'number') return;

      const weatherResponse = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${place.latitude}&longitude=${place.longitude}&current=temperature_2m`,
      );
      const weather = await weatherResponse.json();
      const temperature = weather?.current?.temperature_2m;

      if (typeof temperature !== 'number') return;

      if (place.city) cityEl.textContent = place.city;
      tempEl.textContent = `${Math.round(temperature)}\u00B0C`;
    } catch {
      // Offline, blocked or rate limited - the newsroom reading stands.
    }
  }

  void renderLocalWeather();
</script>
