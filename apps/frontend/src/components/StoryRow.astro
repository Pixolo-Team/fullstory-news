---
import type { ArticleData } from '@/types/api.types';
import { buildStoryPathService } from '@/services/build-story-path.service';
import { formatDateService } from '@/services/format-date.service';

interface Props {
  article: ArticleData;
  showAuthor?: boolean;
}

const { article, showAuthor = false } = Astro.props;
const href = buildStoryPathService(article);
---

<article
  class="grid items-start gap-6 border-b py-5 sm:grid-cols-[minmax(0,1fr)_10.5rem]"
  data-row="listing"
  style="border-bottom-width:var(--border-width);border-color:var(--color-border)"
>
  <div class="flex min-w-0 flex-col gap-2">
    <h3
      class="m-0 text-balance text-[1.3125rem] font-medium leading-[1.25]"
      data-story-title
      style="font-family:var(--font-display);letter-spacing:var(--tracking-title)"
    >
      <a class="story-link" href={href}>{article.headline}</a>
    </h3>

    {
      article.subHeadline && (
        <p
          class="m-0 text-pretty"
          style="font-family:var(--font-body);font-size:var(--text-body);line-height:var(--leading-body);color:var(--color-fg-muted)"
        >
          {article.subHeadline}
        </p>
      )
    }

    <p class="remarque-entry-kicker m-0">
      <span class={showAuthor ? '' : 'remarque-entry-section'}>
        {showAuthor ? article.author.name : article.category.name}
      </span>
      <span class="remarque-dot" aria-hidden="true">&middot;</span>
      <span>{formatDateService(article.publishedAt)}</span>
    </p>
  </div>

  {
    article.heroImageUrl && (
      <a class="block no-underline" data-thumb href={href}>
        <img
          alt=""
          class="block aspect-[3/2] w-full rounded-sm border object-cover"
          loading="lazy"
          src={article.heroImageUrl}
          style="border-width:var(--border-width);border-color:var(--color-border)"
        />
      </a>
    )
  }
</article>
