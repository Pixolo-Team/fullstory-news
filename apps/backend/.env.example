PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:4321

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co

# "Publishable key" (sb_publishable_...). Safe to expose. Respects RLS.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# "Secret key" (sb_secret_...). SERVER ONLY. Bypasses RLS.
# Never expose this to a browser bundle or copy it into another app.
SUPABASE_SECRET_KEY=your-secret-key

# Supabase > Project Settings > Database > Connection string > Direct connection.
# Replace [YOUR-PASSWORD] with the database password. SERVER ONLY.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
