{
  "name": "@full-story/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && concurrently -k -n build,alias,api -c blue,magenta,green \"nest build --watch --preserveWatchOutput\" \"tsc-alias -w\" \"nodemon\"",
    "build": "nest build && tsc-alias",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:check": "node --env-file=.env scripts/check-connection.mjs",
    "start:prod": "node --env-file=.env dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.5",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.5",
    "@nestjs/platform-express": "^11.0.5",
    "@nestjs/swagger": "^11.0.3",
    "@supabase/supabase-js": "^2.48.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.3"
  },
  "type": "module"
}
